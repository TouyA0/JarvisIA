# Secrets
.env

# Python
__pycache__/
*.pyc

# Sorties de rendu du HUD (preview design)
agents/desktop/build_preview/

# Données personnelles générées à l'usage
data/logs/
data/notes/
data/usage.json
data/memory.json
data/current_mode.json
data/device_id.json
data/devices.json
data/cross_device_routines.json
data/integrations.json
data/integrations.key
data/integrations_settings.json
data/proactive_state.json
data/preferences.json

# Audio d'entraînement wake word (volumineux)
agents/desktop/wakeword/samples_jarvis/
agents/desktop/wakeword/samples_negatifs/

# Modèles (optionnel si lourd)
*.onnx
*.tflite
# Modèle de mot d'éveil de la voix web (quelques centaines de Ko, pas un
# binaire lourd comme onnxruntime) : nécessaire au clone pour que
# InferenceSession.create() le trouve (voir web/src/lib/wakeWordDetector.js).
!web/public/models/*.onnx

# Web (web/)
web/node_modules/
web/dist/
# Runtime tiers copié depuis node_modules/onnxruntime-web/dist — pas du
# code projet, à recopier après npm install (voir docs/ROADMAP_MULTIDEVICE.md,
# Phase 9) plutôt que de versionner un binaire de 13 Mo qui ne change que si
# la dépendance change de version.
web/public/ort/

# VS Code / OS
.vscode/
.DS_Store
Thumbs.db
